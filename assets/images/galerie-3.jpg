<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0A0F1A"/>
  
  <!-- Hintergrund-Effekt -->
  <rect width="400" height="300" fill="url(#gradient)" opacity="0.3"/>
  
  <!-- Parkour-Blöcke -->
  <rect x="50" y="200" width="30" height="30" rx="2" fill="#7C4DFF"/>
  <rect x="100" y="180" width="30" height="30" rx="2" fill="#38BDF8"/>
  <rect x="150" y="160" width="30" height="30" rx="2" fill="#FFFFFF"/>
  <rect x="200" y="140" width="30" height="30" rx="2" fill="#7C4DFF"/>
  <rect x="250" y="120" width="30" height="30" rx="2" fill="#38BDF8"/>
  <rect x="300" y="100" width="30" height="30" rx="2" fill="#FFFFFF"/>
  
  <!-- Spieler (einfache Darstellung) -->
  <rect x="120" y="120" width="10" height="20" rx="2" fill="#00FF00"/>
  <rect x="115" y="110" width="20" height="10" rx="2" fill="#00FF00"/>
  <rect x="122" y="100" width="6" height="10" rx="1" fill="#FFD700"/>
  
  <!-- Titel -->
  <text x="200" y="250" font-family="Poppins, sans-serif" font-size="24" font-weight="600" fill="#FFFFFF" text-anchor="middle">Parkour</text>
  <text x="200" y="280" font-family="Poppins, sans-serif" font-size="14" fill="#A0A0A0" text-anchor="middle">IdeenGames Map</text>
  
  <!-- Dekorative Partikel -->
  <circle cx="80" cy="50" r="2" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="150" cy="30" r="3" fill="#38BDF8" opacity="0.7"/>
  <circle cx="250" cy="40" r="2" fill="#FFFFFF" opacity="0.7"/>
  <circle cx="320" cy="60" r="4" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="380" cy="80" r="3" fill="#38BDF8" opacity="0.7"/>
  
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FFFFFF" stop-opacity="0.05"/>
      <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.1"/>
    </linearGradient>
  </defs>
</svg>
