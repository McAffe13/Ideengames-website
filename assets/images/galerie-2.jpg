<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0A0F1A"/>
  
  <!-- Hintergrund-Effekt -->
  <rect width="400" height="300" fill="url(#gradient)" opacity="0.3"/>
  
  <!-- Bett (BedWars) -->
  <rect x="100" y="150" width="80" height="20" rx="3" fill="#8B4513"/>
  <rect x="100" y="140" width="80" height="10" rx="3" fill="#A0522D"/>
  <rect x="105" y="130" width="70" height="10" rx="3" fill="#FFFFFF"/>
  
  <!-- Schwert -->
  <rect x="200" y="100" width="5" height="40" rx="1" fill="#C0C0C0"/>
  <rect x="195" y="100" width="15" height="5" rx="1" fill="#C0C0C0"/>
  
  <!-- Titel -->
  <text x="200" y="250" font-family="Poppins, sans-serif" font-size="24" font-weight="600" fill="#FFFFFF" text-anchor="middle">BedWars</text>
  <text x="200" y="280" font-family="Poppins, sans-serif" font-size="14" fill="#A0A0A0" text-anchor="middle">IdeenGames Map</text>
  
  <!-- Dekorative Partikel -->
  <circle cx="50" cy="50" r="4" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="350" cy="60" r="3" fill="#38BDF8" opacity="0.7"/>
  <circle cx="300" cy="100" r="2" fill="#FFFFFF" opacity="0.7"/>
  <circle cx="40" cy="200" r="3" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="380" cy="250" r="2" fill="#38BDF8" opacity="0.7"/>
  
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#38BDF8" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#7C4DFF" stop-opacity="0.1"/>
    </linearGradient>
  </defs>
</svg>
