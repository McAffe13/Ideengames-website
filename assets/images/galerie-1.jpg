<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0A0F1A"/>
  
  <!-- Hintergrund-Effekt -->
  <rect width="400" height="300" fill="url(#gradient)" opacity="0.3"/>
  
  <!-- Minecraft-Block -->
  <rect x="50" y="50" width="50" height="50" rx="5" fill="#7C4DFF"/>
  <rect x="100" y="50" width="50" height="50" rx="5" fill="#38BDF8"/>
  <rect x="50" y="100" width="50" height="50" rx="5" fill="#38BDF8"/>
  <rect x="100" y="100" width="50" height="50" rx="5" fill="#7C4DFF"/>
  
  <!-- Titel -->
  <text x="200" y="200" font-family="Poppins, sans-serif" font-size="24" font-weight="600" fill="#FFFFFF" text-anchor="middle">SkyWars</text>
  <text x="200" y="230" font-family="Poppins, sans-serif" font-size="14" fill="#A0A0A0" text-anchor="middle">IdeenGames Map</text>
  
  <!-- Dekorative Partikel -->
  <circle cx="300" cy="80" r="3" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="320" cy="120" r="2" fill="#38BDF8" opacity="0.7"/>
  <circle cx="350" cy="150" r="4" fill="#FFFFFF" opacity="0.7"/>
  <circle cx="280" cy="200" r="2" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="340" cy="220" r="3" fill="#38BDF8" opacity="0.7"/>
  
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7C4DFF" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.1"/>
    </linearGradient>
  </defs>
</svg>
