<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0A0F1A"/>
  
  <!-- Hintergrund-Effekt -->
  <rect width="400" height="300" fill="url(#gradient)" opacity="0.3"/>
  
  <!-- Dolch (MurderMystery) -->
  <rect x="150" y="100" width="5" height="30" rx="1" fill="#8B0000"/>
  <rect x="145" y="100" width="15" height="5" rx="1" fill="#8B0000"/>
  <circle cx="152" cy="95" r="3" fill="#8B0000"/>
  
  <!-- Blutstropfen (Dekoration) -->
  <ellipse cx="200" cy="200" rx="8" ry="12" fill="#8B0000" opacity="0.8"/>
  <ellipse cx="220" cy="180" rx="6" ry="10" fill="#8B0000" opacity="0.8"/>
  <ellipse cx="180" cy="220" rx="5" ry="8" fill="#8B0000" opacity="0.8"/>
  
  <!-- Titel -->
  <text x="200" y="250" font-family="Poppins, sans-serif" font-size="24" font-weight="600" fill="#FFFFFF" text-anchor="middle">MurderMystery</text>
  <text x="200" y="280" font-family="Poppins, sans-serif" font-size="14" fill="#A0A0A0" text-anchor="middle">IdeenGames Map</text>
  
  <!-- Dekorative Partikel -->
  <circle cx="40" cy="40" r="2" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="360" cy="30" r="3" fill="#38BDF8" opacity="0.7"/>
  <circle cx="300" cy="80" r="2" fill="#FFFFFF" opacity="0.7"/>
  <circle cx="20" cy="150" r="4" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="380" cy="200" r="3" fill="#38BDF8" opacity="0.7"/>
  
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#8B0000" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#000000" stop-opacity="0.2"/>
    </linearGradient>
  </defs>
</svg>
