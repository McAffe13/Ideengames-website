<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300" width="400" height="300">
  <rect width="400" height="300" fill="#0A0F1A"/>
  
  <!-- Hintergrund-Effekt -->
  <rect width="400" height="300" fill="url(#gradient)" opacity="0.3"/>
  
  <!-- Arena -->
  <rect x="50" y="150" width="300" height="50" rx="5" fill="#8B4513" opacity="0.8"/>
  <rect x="70" y="130" width="260" height="20" rx="3" fill="#A0522D" opacity="0.8"/>
  
  <!-- Schwerter (Duels) -->
  <rect x="120" y="80" width="4" height="40" rx="1" fill="#C0C0C0"/>
  <rect x="117" y="80" width="10" height="3" rx="1" fill="#C0C0C0"/>
  <circle cx="122" y="75" r="3" fill="#FFD700"/>
  
  <rect x="280" y="80" width="4" height="40" rx="1" fill="#C0C0C0"/>
  <rect x="277" y="80" width="10" height="3" rx="1" fill="#C0C0C0"/>
  <circle cx="282" y="75" r="3" fill="#FFD700"/>
  
  <!-- Titel -->
  <text x="200" y="250" font-family="Poppins, sans-serif" font-size="24" font-weight="600" fill="#FFFFFF" text-anchor="middle">Duels</text>
  <text x="200" y="280" font-family="Poppins, sans-serif" font-size="14" fill="#A0A0A0" text-anchor="middle">IdeenGames Map</text>
  
  <!-- Dekorative Partikel -->
  <circle cx="30" cy="60" r="3" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="370" cy="40" r="2" fill="#38BDF8" opacity="0.7"/>
  <circle cx="200" cy="30" r="4" fill="#FFFFFF" opacity="0.7"/>
  <circle cx="10" cy="180" r="2" fill="#7C4DFF" opacity="0.7"/>
  <circle cx="390" cy="220" r="3" fill="#38BDF8" opacity="0.7"/>
  
  <defs>
    <linearGradient id="gradient" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#7C4DFF" stop-opacity="0.1"/>
      <stop offset="100%" stop-color="#38BDF8" stop-opacity="0.1"/>
    </linearGradient>
  </defs>
</svg>
